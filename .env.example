# 站点公开地址，用于生成 Open Graph 绝对链接。
NEXT_PUBLIC_SITE_URL=https://docs.example.com

# 子路径部署时填写，例如 GitHub 项目 Pages 使用 /agent-guide；根域名部署留空。
NEXT_PUBLIC_BASE_PATH=

# giscus 配置由 https://giscus.app/zh-CN 生成，四项必须同时填写。
NEXT_PUBLIC_GISCUS_REPO=guide-agent/agent-guide-discussions
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOTeJAfA
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOTeJAfM4DBlaP
